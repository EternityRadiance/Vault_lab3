DATABASE_URL=sqlite:///./vault.db

# Generate secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=60

# Generate secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
PASSWORD_PEPPER=replace_with_another_long_random_string_at_least_32_chars
PASSWORD_MIN_LENGTH=12

ENVIRONMENT=development
APP_NAME=Vault

REDIS_URL=redis://localhost:6379/0
ISSUER=http://127.0.0.1:8000
RSA_KEY_PATH=./keys/rsa_private.pem
RSA_KEY_ID=vault-key-1
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_CODE_TTL_SEC=60
PKCE_REQUIRED_FOR_PUBLIC=true
